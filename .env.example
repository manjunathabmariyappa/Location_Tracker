# Firebase web configuration. These values identify the Firebase project but are kept local
# so each family deployment can choose its own Firebase project.
EXPO_PUBLIC_FIREBASE_API_KEY=replace-me
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-me.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=replace-me
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-me.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-me
EXPO_PUBLIC_FIREBASE_APP_ID=replace-me

# Public GitHub repository used for release checks.
EXPO_PUBLIC_GITHUB_OWNER=your-github-user
EXPO_PUBLIC_GITHUB_REPOSITORY=family-safety-tracker
